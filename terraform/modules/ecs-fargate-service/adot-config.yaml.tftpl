# OpenTelemetry collector (ADOT) sidecar config, rendered per service by Terraform.
extensions:
  sigv4auth:
    region: ${region}
    service: aps
  health_check: {}

receivers:
  prometheus:
    config:
      global:
        scrape_interval: 15s
      scrape_configs:
        - job_name: ${service_name}
          metrics_path: ${metrics_path}
          static_configs:
            - targets: ["localhost:${app_port}"]
              labels:
                service: ${service_name}
                env: ${environment}
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch: {}
  memory_limiter:
    check_interval: 1s
    limit_percentage: 80
    spike_limit_percentage: 25
  # Defense in depth: strip attributes that commonly carry PHI before export.
  attributes/scrub_phi:
    actions:
      - key: http.request.body
        action: delete
      - key: db.statement
        action: hash
      - key: enduser.id
        action: hash
      - key: url.query
        action: delete
  resourcedetection:
    detectors: [env, ecs]

exporters:
  prometheusremotewrite:
    endpoint: ${amp_endpoint}api/v1/remote_write
    auth:
      authenticator: sigv4auth
    resource_to_telemetry_conversion:
      enabled: true
%{ if traces_endpoint != "" ~}
  otlp/traces:
    endpoint: ${traces_endpoint}
    tls:
      insecure: false
%{ else ~}
  # No Tempo endpoint configured (demo): send traces to AWS X-Ray instead.
  awsxray:
    region: ${region}
%{ endif ~}

service:
  extensions: [sigv4auth, health_check]
  pipelines:
    metrics:
      receivers: [prometheus, otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [prometheusremotewrite]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, attributes/scrub_phi, resourcedetection, batch]
      exporters: [${traces_endpoint != "" ? "otlp/traces" : "awsxray"}]
